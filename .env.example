# Copy to .env for local development (never commit .env). On Railway set these as service variables.

# --- required ---
BOT_TOKEN=123456789:replace-with-token-from-BotFather
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# --- optional (defaults shown) ---
# MONGODB_DB=tele_dupbot
# LOG_LEVEL=info                    # debug | info | warn | error
# PORT=                             # set to expose GET /healthz

# Media limits (Telegram bots can only download files up to 20 MB)
# MAX_VIDEO_SIZE_MB=20
# MAX_VIDEO_DURATION_SEC=600

# Fingerprinting / matching
# FRAME_SAMPLES=12
# FRAME_MATCH_MAX_DISTANCE=10
# MAX_FRAME_SHIFT=1
# DURATION_TOLERANCE_SEC=2
# DURATION_TOLERANCE_PCT=0.05
# MAX_CANDIDATES=8

# Queue / reliability
# WORKER_CONCURRENCY=1
# MAX_QUEUE_SIZE=200
# JOB_MAX_ATTEMPTS=3
# JOB_STALE_AFTER_MS=600000

# Approval workflow
# APPROVAL_TTL_HOURS=5
# RECORD_RETENTION_DAYS=30
